@page "/planners/{RawId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using MyPlanner.Application.Abstractions.Messaging
@using MyPlanner.Application.Features.Planners.Commands.AddTodo
@using MyPlanner.Application.Features.Planners.Commands.ChangeTodoDescription
@using MyPlanner.Application.Features.Planners.Commands.ChangeTodoTitle
@using MyPlanner.Application.Features.Planners.Commands.RemoveTodo
@using MyPlanner.Application.Features.Planners.Queries.GetPlannerDetails
@using MyPlanner.Domain.Planners
@using MyPlanner.Web.Components.Features.Planners.Extensions
@using MyPlanner.Web.Components.Features.Planners.Models

@inject IScopedSender _sender

<PageTitle>Planner details</PageTitle>
<h3>Planner details</h3>

@if (_errorMessage != null)
{
    <div class="text-bg-danger">
        @_errorMessage
    </div>
}

@if (Planner == null)
{
    <p>Loading planner...</p>
}
else
{
    <div class="planner-page">
        <div class="planner-page-header">
            <div>
                <p class="planner-eyebrow">PLANNER</p>
                <h3>@Planner.Title</h3>
            </div>

            <button class="create-todo-btn" @onclick="OnCreateTodoClicked">
                + New Todo
            </button>
        </div>

        <div class="todo-section">
            <div class="todo-section-header">
                <h4>Todos</h4>
                <span class="todo-count">@Planner.Todos.Count</span>
            </div>

            <div class="todo-list">
                @foreach (var todo in Planner.Todos)
                {
                    <div class="todo-card">
                        <div class="todo-content">
                            <div class="todo-title">
                                @todo.Title
                            </div>

                            @if (!string.IsNullOrWhiteSpace(todo.Description))
                            {
                                <div class="todo-description">
                                    @todo.Description
                                </div>
                            }
                        </div>
                        <div class="todo-actions planner-overview-actions">
                            <button type="button"
                                    class="planner-card-delete"
                                    @onclick="() => OnRemoveTodoClicked(todo.Id)"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true">
                                ×
                            </button>
                            <button type="button"
                                    class="todo-menu-btn"
                                    @onclick="() => OnTodoMenuClicked(todo.Id)"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true">
                                ...
                            </button>
                            @if (_openTodoMenuId == todo.Id)
                            {
                                <div class="todo-dropdown">
                                    <button type="button"
                                         @onclick="() => OnChangeTodoTitleClicked(todo.Id)">
                                        Edit Title
                                    </button>
                                    <button type="button"
                                            @onclick="() => OnChangeTodoDescriptionClicked(todo.Id)">
                                        Edit Description
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
@if (_isCreatingTodo)
{
    <div class="create-todo-card">
        <div class="create-todo-header">
            <div>
                <p class="create-todo-eyebrow">NEW TODO</p>
                <h4>Create a new todo</h4>
            </div>

            <button type="button"
                    class="close-todo-btn"
                    @onclick="() => _isCreatingTodo = false">
                ×
            </button>
        </div>

        <EditForm Model="@_todoCreateModel" OnValidSubmit="HandleCreateTodoSubmit">
            <DataAnnotationsValidator />
            <div class="todo-form-group">
                <label for="Title">Title</label>
                <InputText @bind-Value="_todoCreateModel.Title"
                           id="Title"
                           class="todo-input"
                           placeholder="What needs to be done?" />
            </div>
            <ValidationSummary />

            <div class="todo-form-actions">
                <button type="button"
                        class="cancel-todo-btn"
                        @onclick="() => _isCreatingTodo = false">
                    Cancel
                </button>
                <button type="submit"
                        class="save-todo-btn">
                    Create Todo
                </button>
            </div>
        </EditForm>
    </div>
}
@if (_isChangingTodoTitle)
{
    <div class="edit-title-overlay">
        <div class="edit-title-card">
            <div class="create-todo-header">
                <div>
                    <p class="create-todo-eyebrow">EDIT TODO</p>
                    <h4>Change title</h4>
                </div>

                <button type="button"
                        class="close-todo-btn"
                        @onclick="OnCancelChangeTodoTitleClicked">
                    ×
                </button>
            </div>

            <EditForm Model="@_todoChangeTitleModel"
                      OnValidSubmit="HandleChangeTodoTitleSubmit">
                <DataAnnotationsValidator />
                <div class="todo-form-group">
                    <label for="NewTitle">New title</label>
                    <InputText @bind-Value="_todoChangeTitleModel.NewTitle"
                               id="NewTitle"
                               class="todo-input"
                               placeholder="Enter new title" />
                    <ValidationMessage For="@(() => _todoChangeTitleModel.NewTitle)" />
                </div>

                <div class="todo-form-actions">
                    <button type="button"
                            class="cancel-todo-btn"
                            @onclick="OnCancelChangeTodoTitleClicked">
                        Cancel
                    </button>

                    <button type="submit"
                            class="save-todo-btn">
                        Save
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}
@if (_isChangingTodoDescription)
{
    <div class="edit-title-overlay">
        <div class="edit-title-card">
            <div class="create-todo-header">
                <div>
                    <p class="create-todo-eyebrow">EDIT TODO</p>
                    <h4>Change description</h4>
                </div>

                <button type="button"
                        class="close-todo-btn"
                        @onclick="OnCancelChangeTodoDescriptionClicked">
                    ×
                </button>
            </div>

            <EditForm Model="@_todoChangeDescriptionModel"
                      OnValidSubmit="HandleChangeTodoDescriptionSubmit">
                <DataAnnotationsValidator />
                <div class="todo-form-group">
                    <label for="NewDescription">New description</label>
                    <InputTextArea @bind-Value="_todoChangeDescriptionModel.NewDescription"
                               id="NewDescription"
                               class="todo-input"
                               placeholder="Enter new description" />
                    <ValidationMessage For="@(() => _todoChangeDescriptionModel.NewDescription)" />
                </div>

                <div class="todo-form-actions">
                    <button type="button"
                            class="cancel-todo-btn"
                            @onclick="OnCancelChangeTodoDescriptionClicked">
                        Cancel
                    </button>

                    <button type="submit"
                            class="save-todo-btn">
                        Save
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}


@code {
    [Parameter]
    public Guid RawId { get; set; }

    private string? _errorMessage;
    private TodoId? _openTodoMenuId;

    private PlannerDetailsModel? Planner { get; set; }

    private bool _isCreatingTodo;
    private bool _isChangingTodoTitle;
    private bool _isChangingTodoDescription;

    private TodoChangeTitleModel _todoChangeTitleModel = new();
    private TodoChangeDescriptionModel _todoChangeDescriptionModel = new();
    private TodoCreateModel _todoCreateModel = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await _sender.Query(new GetPlannerDetailsQuery(new PlannerId(RawId)));

        if (result.IsSuccess)
        {
            Planner = result.Value.ToUiModel();
        }

        if (result.IsFailure)
        {
            _errorMessage = result.Error.Description;
        }
    }

    private void OnTodoMenuClicked(TodoId Id)
    {
        _openTodoMenuId = _openTodoMenuId == Id ? null : Id;
    }

    private void OnCreateTodoClicked()
    {
        _todoCreateModel = new();
        _isCreatingTodo = true;
        _errorMessage = null;
    }

    private async Task HandleCreateTodoSubmit()
    {
        if (Planner == null)
        {
            return;
        }

        var command = new AddTodoCommand(Planner!.Id, _todoCreateModel.Title);

        var result = await _sender.Command(command);

        if (result.IsSuccess)
        {
            var response = result.Value;
            Planner.Todos.Add(new TodoDetailsModel(response.TodoId, response.Title, response.Description));
        }

        if (result.IsFailure)
        {
            _errorMessage = result.Error.Description;
        }

        _isCreatingTodo = false;
    }

    private async Task OnRemoveTodoClicked(TodoId id)
    {
        var command = new RemoveTodoCommand(Planner!.Id, id);

        var result = await _sender.Command(command);

        if (result.IsSuccess)
        {
            Planner!.Todos.RemoveAll(t => t.Id == id);
        }

        if (result.IsFailure)
        {
            _errorMessage = result.Error.Description;
        }
    }

    private void OnChangeTodoTitleClicked(TodoId id)
    {
        var todo = Planner?.Todos.FirstOrDefault(t => t.Id == id);

        if (todo == null)
        {
            return;
        }

        _todoChangeTitleModel = new TodoChangeTitleModel
        {
            PlannerId = Planner!.Id,
            TodoId = id,
            NewTitle = todo.Title
        };

        _errorMessage = null;
        _isChangingTodoTitle = true;
        _openTodoMenuId = null;
    }

    private async Task HandleChangeTodoTitleSubmit()
    {
        var command = new ChangeTodoTitleCommand(
            _todoChangeTitleModel.PlannerId,
            _todoChangeTitleModel.TodoId,
            _todoChangeTitleModel.NewTitle);

        var result = await _sender.Command(command);

        if (result.IsFailure)
        {
            _errorMessage = result.Error.Description;
            return;
        }

        if (result.IsNoOp)
        {
            OnCancelChangeTodoTitleClicked();
            return;
        }

        if (result.IsSuccess)
        {
            var todo = Planner?.Todos.FirstOrDefault(t => t.Id == result.Value.TodoId);

            if (todo != null)
            {
                todo.Title = result.Value.NewTitle;
            }

            _errorMessage = null;
            OnCancelChangeTodoTitleClicked();
        }
    }

    private void OnCancelChangeTodoTitleClicked()
    {
        _isChangingTodoTitle = false;
    }

    private async Task HandleChangeTodoDescriptionSubmit()
    {
        var command = new ChangeTodoDescriptionCommand(
            _todoChangeDescriptionModel.PlannerId,
            _todoChangeDescriptionModel.TodoId,
            _todoChangeDescriptionModel.NewDescription);

        var result = await _sender.Command(command);

        if (result.IsFailure)
        {
            _errorMessage = result.Error.Description;
            return;
        }

        if (result.IsNoOp)
        {
            OnCancelChangeTodoDescriptionClicked();
            return;
        }

        if (result.IsSuccess)
        {
            var todo = Planner?.Todos.FirstOrDefault(t => t.Id == result.Value.TodoId);

            if (todo != null)
            {
                todo.Description = result.Value.NewDescription;
            }

            _errorMessage = null;
            OnCancelChangeTodoDescriptionClicked();
        }
    }

    private void OnChangeTodoDescriptionClicked(TodoId id)
    {
        var todo = Planner?.Todos.FirstOrDefault(t => t.Id == id);

        if (todo == null || Planner == null)
        {
            return;
        }

        _todoChangeDescriptionModel = new TodoChangeDescriptionModel
        {
            PlannerId = Planner!.Id,
            TodoId = id,
            NewDescription = todo.Description
        };

        _errorMessage = null;
        _openTodoMenuId = null;
        _isChangingTodoDescription = true;
    }

    private void OnCancelChangeTodoDescriptionClicked()
    {
        _isChangingTodoDescription = false;
    }
}
