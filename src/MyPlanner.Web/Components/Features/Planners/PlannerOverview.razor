@page "/planners"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using MyPlanner.Application.Abstractions.Messaging
@using MyPlanner.Application.Features.Planners.Commands.ChangePlannerTitle
@using MyPlanner.Application.Features.Planners.Commands.CreatePlanner
@using MyPlanner.Application.Features.Planners.Commands.DeletePlanner
@using MyPlanner.Application.Features.Planners.Queries.GetPlannerOverviews
@using MyPlanner.Domain.Planners
@using MyPlanner.Web.Components.Features.Planners.Extensions
@using MyPlanner.Web.Components.Features.Planners.Models

@inject IScopedSender _sender

<PageTitle>Planner overview</PageTitle>
<h3>Planner overview</h3>

@if (_errorMessage != null)
{
    <div class="text-bg-danger">
        @_errorMessage
    </div>
}

<div class="planner-overview">
    <div class="overview-header">
        <div>
            <p class="planner-eyebrow">WORKSPACE</p>
            <h3>My Planners</h3>
            <p class="overview-subtitle">
                Manage your planners and keep your tasks organized.
            </p>
        </div>
        @if (!_isCreatingPlanner)
        {
            <button class="create-todo-btn" @onclick="OnCreatePlannerClicked">
                + New Planner
            </button>
        }
    </div>

    @if (_isCreatingPlanner)
    {
        <div class="create-planner-card">
            <div class="create-todo-header">
                <div>
                    <p class="create-todo-eyebrow">NEW PLANNER</p>
                    <h4>Create a new planner</h4>
                </div>

                <button type="button"
                class="close-todo-btn"
                @onclick="() => _isCreatingPlanner = false">
                    ×
                </button>
            </div>
            <EditForm Model="@_plannerCreateModel"
            OnValidSubmit="HandleCreatePlannerSubmit">
                <DataAnnotationsValidator />
                <div class="todo-form-group">
                    <label for="Title">Title</label>

                    <InputText @bind-Value="_plannerCreateModel.Title"
                    id="Title"
                    class="todo-input"
                    placeholder="What is this planner for?" />
                </div>
                <ValidationSummary />
                <div class="todo-form-actions">
                    <button type="button"
                    class="cancel-todo-btn"
                    @onclick="() => _isCreatingPlanner = false">
                        Cancel
                    </button>
                    <button type="submit"
                    class="save-todo-btn">
                        Create Planner
                    </button>
                </div>
            </EditForm>
        </div>
    }

    @if (_isChangingPlannerTitle)
    {
        <div class="edit-title-overlay">
            <div class="edit-title-card">
                <div class="create-todo-header">
                    <div>
                        <p class="create-todo-eyebrow">EDIT PLANNER</p>
                        <h4>Change title</h4>
                    </div>

                    <button type="button"
                            class="close-todo-btn"
                            @onclick="OnCancelChangePlannerTitle">
                        ×
                    </button>
                </div>

                <EditForm Model="@_plannerChangeTitleModel"
                          OnValidSubmit="HandleChangePlannerTitleSubmit">
                    <DataAnnotationsValidator />

                    <div class="todo-form-group">
                        <label for="NewTitle">New title</label>

                        <InputText @bind-Value="_plannerChangeTitleModel.NewTitle"
                                   id="NewTitle"
                                   class="todo-input"
                                   placeholder="Enter new title" />

                        <ValidationMessage For="@(() => _plannerChangeTitleModel.NewTitle)" />
                    </div>

                    <div class="todo-form-actions">
                        <button type="button"
                                class="cancel-todo-btn"
                                @onclick="OnCancelChangePlannerTitle">
                            Cancel
                        </button>

                        <button type="submit"
                                class="save-todo-btn">
                            Save
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
    <div class="planner-overview-section">
        <div class="todo-section-header">
            <h4>Your planners</h4>
            <span class="todo-count">
                @_plannerOverviewModels.Count
            </span>
        </div>

        @if (_plannerOverviewModels.Count == 0)
        {
            <div class="empty-planner-state">
                <div class="empty-planner-icon">+</div>

                <h4>No planners yet</h4>
                <p>
                    Create your first planner to get started.
                </p>
                @if (!_isCreatingPlanner)
                {
                    <button class="save-todo-btn"
                    @onclick="OnCreatePlannerClicked">
                        Create Planner
                    </button>
                }
            </div>
        }
        else
        {
            <div class="planner-grid">
                @foreach (var planner in _plannerOverviewModels)
                {
                    <div class="planner-card-wrapper">
                        <a class="planner-card" href="/planners/@planner.Id">
                            <div class="planner-card-content">
                                <div class="planner-card-info">
                                    <div class="planner-card-title">
                                        @planner.Title
                                    </div>
                                </div>
                            </div>
                        </a>
                        <div class="todo-actions planner-overview-actions">
                            <button type="button"
                                    class="planner-card-delete"
                                    @onclick="() => OnDeletePlannerClicked(planner.Id)"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true">
                                ×
                            </button>
                            <button type="button" 
                                    class="todo-menu-btn"
                                    @onclick="() => OnChangePlannerTitleClicked(planner.Id)"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true">
                                ...
                            </button>
                        </div>   
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string? _errorMessage;

    private bool _isCreatingPlanner;
    private bool _isChangingPlannerTitle;
    private PlannerId? _editingPlannerId;

    private PlannerChangeTitleModel _plannerChangeTitleModel = new();

    private PlannerCreateModel _plannerCreateModel = new();

    private List<PlannerOverviewModel> _plannerOverviewModels = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await _sender.Query(new GetPlannerOverviewsQuery());

        if (result.IsSuccess)
        {
            var uiModels = result.Value.Select(p => p.ToUiModel()).ToList();
            _plannerOverviewModels = uiModels;
        }

        if (result.IsFailure)
        {
            _errorMessage = result.Error.Description;
        }
    }

    private void OnCreatePlannerClicked()
    {
        _plannerCreateModel = new();
        _isCreatingPlanner = true;
        _errorMessage = null;
    }

    private async Task HandleCreatePlannerSubmit()
    {
        var command = new CreatePlannerCommand(_plannerCreateModel.Title);

        var result = await _sender.Command(command);

        if (result.IsSuccess)
        {
            var uiModel = new PlannerOverviewModel(result.Value.PlannerId, result.Value.Title);
            _plannerOverviewModels.Add(uiModel);
        }

        if (result.IsFailure)
        {
            _errorMessage = result.Error.Description;

        }

        _isCreatingPlanner = false;
    } 

    private async Task OnDeletePlannerClicked(PlannerId id)
    {
        var command = new DeletePlannerCommand(id);

        var result = await _sender.Command(command);

        if (result.IsSuccess)
        {
            _plannerOverviewModels.RemoveAll(p => p.Id == id);
        }

        if(result.IsFailure)
        {
            _errorMessage = result.Error.Description;
        }
    }

    private void OnChangePlannerTitleClicked(PlannerId id)
    {
        var planner = _plannerOverviewModels.FirstOrDefault(p => p.Id == id);

        if(planner == null)
        {
            return;
        }

        _editingPlannerId = id;
        _plannerChangeTitleModel = new PlannerChangeTitleModel
        {
            NewTitle = planner.Title
        };

        _errorMessage = null;
        _isChangingPlannerTitle = true;  
    }

    private void OnCancelChangePlannerTitle()
    {
        _isChangingPlannerTitle = false;
        _editingPlannerId = null;
    }

    private async Task HandleChangePlannerTitleSubmit()
    {
        if (_editingPlannerId == null)
        {
            return;
        }
        
        var command = new ChangePlannerTitleCommand(
            _editingPlannerId.Value,
            _plannerChangeTitleModel.NewTitle);

        var result = await _sender.Command(command);

        if (result.IsFailure)
        {
            _errorMessage = result.Error.Description;
            return;
        }

        if (result.IsNoOp)
        {
            OnCancelChangePlannerTitle();
            return;
        }

        if (result.IsSuccess)
        {
            var planner = _plannerOverviewModels.FirstOrDefault(p => p.Id == _editingPlannerId.Value);

            if (planner != null)
            {
                planner.Title = _plannerChangeTitleModel.NewTitle;
            }

            _errorMessage = null;
            OnCancelChangePlannerTitle();
        }
    }
}
